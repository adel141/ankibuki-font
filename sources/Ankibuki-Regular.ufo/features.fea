        } ChainingContext23;

        lookup ChainingContext24 { # GSUB lookup type ChainingContext
            sub @CG_32 @CG_30' lookup SingleSubstitution44;
        } ChainingContext24;

        lookup ChainingContext25 { # GSUB lookup type ChainingContext
            sub @CG_30 space' lookup SingleSubstitution45 @CG_31;
        } ChainingContext25;

        lookup Ligature31 { # GSUB lookup type Ligature
            sub five.num fraction eight.den by fiveeighths;
            sub three.num fraction eight.den by threeeighths;
            sub three.num fraction four.den by threequarters;
            sub seven.num fraction eight.den by seveneighths;
            sub one.num fraction eight.den by oneeighth;
            sub one.num fraction two.den by onehalf;
            sub one.num fraction four.den by onequarter;
            sub one.num fraction three.den by uni2153;
            sub two.num fraction three.den by uni2154;
        } Ligature31;

        language AZE exclude_dflt; # Azerbaijani
        language CRT exclude_dflt; # Crimean Tatar
        language ROM exclude_dflt; # Romanian
        language TRK exclude_dflt; # Turkish
} frac;

