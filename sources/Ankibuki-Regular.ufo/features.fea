feature kern { # Kerning
    script DFLT; # Default
        lookup PairAdjustment3;

    script latn; # Latin
        lookup PairAdjustment2 { # GPOS lookup type PairAdjustment
            lookupflag IgnoreMarks;
            pos quotedbl V 13;
            pos quotedbl X -13;
            pos quotedbl v 10;
            pos quotedbl x 0;
            pos ampersand A -3;
            pos ampersand C 0;
            pos ampersand G 0;
            pos ampersand J -3;
            pos ampersand O 0;
            pos ampersand Q 0;
            pos ampersand S -10;
            pos ampersand T -68;
            pos ampersand U -8;
            pos ampersand V -63;
            pos ampersand W -37;
            pos ampersand X -7;
            pos ampersand Y -80;
            pos ampersand Z 3;
            pos ampersand a -7;
            pos ampersand c -10;
            pos ampersand e -10;
            pos ampersand o -10;
            pos ampersand u -2;
            pos ampersand v -22;
            pos ampersand w -15;
            pos ampersand x -3;
            pos ampersand y -25;
            pos ampersand z 7;
            pos ampersand Agrave -3;
            pos ampersand Aacute -3;
            pos ampersand Acircumflex -3;
            pos ampersand Atilde -3;
            pos ampersand Adieresis -3;
            pos ampersand Aring -3;
            pos ampersand AE -5;
            pos ampersand Ccedilla 0;
            pos ampersand Eth 7;
            pos ampersand Ograve 0;
            pos ampersand Oacute 0;
            pos ampersand Ocircumflex 0;
            pos ampersand Otilde 0;
            pos ampersand Odieresis 0;
            pos ampersand Oslash 0;
            pos ampersand Ugrave -8;
            pos ampersand Uacute -8;
            pos ampersand Ucircumflex -8;
            pos ampersand Udieresis -8;
            pos ampersand Yacute -80;
